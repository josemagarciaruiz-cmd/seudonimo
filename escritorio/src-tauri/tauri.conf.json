{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seudónimo",
  "mainBinaryName": "Seudonimo",
  "version": "0.6.1",
  "identifier": "ai.josemaria.seudonimo",
  "build": {
    "frontendDist": "../../interfaz"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "principal",
        "title": "Seudónimo",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "category": "Productivity",
    "copyright": "© 2026 José María García Ruiz · josemaria.ai · PolyForm Shield 1.0.0",
    "shortDescription": "Seudonimización de documentos jurídicos con modelos locales",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}